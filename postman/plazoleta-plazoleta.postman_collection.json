                  "pm.collectionVariables.set(\"ownerToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - HU-2 Crear restaurante",
      "description": "POST /restaurants. Requiere token de ADMIN (se hereda de la coleccion: {{adminToken}}).",
      "item": [
        {
          "name": "Crear restaurante (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/restaurants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants"
              ]
            },
            "description": "Genera un NIT unico en cada ejecucion para poder repetir la coleccion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Restaurante El Sabor\",\n  \"nit\": \"{{restaurantNit}}\",\n  \"address\": \"Calle 10 # 20-30\",\n  \"phone\": \"+573005698325\",\n  \"urlLogo\": \"https://misitio.com/logo.png\",\n  \"ownerId\": {{ownerId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"restaurantNit\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Devuelve el restaurante creado\", () => {",
                  "    pm.expect(body.id).to.be.a(\"number\");",
                  "    pm.expect(body.nit).to.eql(pm.collectionVariables.get(\"restaurantNit\"));",
                  "    pm.expect(body.ownerId).to.eql(Number(pm.collectionVariables.get(\"ownerId\")));",
                  "    pm.expect(body.phone).to.eql(\"+573005698325\");",
                  "});"
                ]
              }
            }
          ]
        },
