{
  "info": {
    "name": "Plazoleta - Plazoleta",
    "description": "Pruebas del microservicio plazoleta-plazoleta.\n\nRequiere ambos microservicios levantados: usuarios ({{usuariosUrl}}) y plazoleta ({{baseUrl}}), cada uno con su PostgreSQL (docker compose up -d).\nOrden de ejecucion: 00 Preparacion -> 01 HU-2 -> 02 Seguridad (usar el Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Preparacion (microservicio usuarios)",
      "description": "Obtiene el token del ADMIN y crea un propietario en plazoleta-usuarios (debe estar levantado en {{usuariosUrl}}).",
      "item": [
        {
          "name": "Login ADMIN (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/auth/login",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear propietario (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/users/owner",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "users",
                "owner"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Pedro\",\n  \"lastName\": \"Gomez\",\n  \"documentNumber\": \"{{ownerDocument}}\",\n  \"phone\": \"+573001112233\",\n  \"birthDate\": \"1985-03-15\",\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"Clave123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const unique = Date.now().toString();",
                  "pm.collectionVariables.set(\"ownerDocument\", unique.slice(-10));",
                  "pm.collectionVariables.set(\"ownerEmail\", \"dueno_\" + unique + \"@correo.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"ownerId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login PROPIETARIO (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/auth/login",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"Clave123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
